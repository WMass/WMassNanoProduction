from CRABClient.UserUtilities import config
config = config()

# a files: input of prepareCrab.py: unpublished files on the MIT ceph, read through the
# MIT xrootd door (userInputFiles), FileBased jobs, no publication

config.General.requestName = '${name}'
config.General.workArea = 'crab_projects'
config.General.transferOutputs = True
config.General.transferLogs = True

config.JobType.numCores = ${threads}
config.JobType.maxMemoryMB = ${memory}
config.JobType.pluginName = 'Analysis'
config.JobType.psetName = '../configs/${config}'
config.JobType.allowUndistributedCMSSW = True
# $$CMSSW_BASE/external carries the OPERA 170812 field tables (not in the 15_0
# data package); run scripts/prepareSandbox.sh before submitting
config.JobType.sendExternalFolder = True

with open('${filelist}') as _f:
    config.Data.userInputFiles = _f.read().split()
config.Data.outputPrimaryDataset = '${primary}'
config.Data.splitting = 'FileBased'
config.Data.unitsPerJob = ${units}
config.Data.outLFNDirBase = '${outstorage}'
config.Data.publication = False
config.Data.outputDatasetTag = '${era}_${version}'

config.Site.whitelist = ${whitelist}
config.Site.storageSite = '${site}'
